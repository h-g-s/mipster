#!/bin/bash
# run-mipster-tests — run the MIPster test suite with concise pass/fail output.
#
# On success prints one line per test:  [N/T] TestName ... PASS (Xs)
# On failure prints the full test output below the FAIL line so problems are
# immediately visible without needing to re-run with --verbose.
#
# Fixture MPS files are located automatically:
#   1. $MIPSTER_FIXTURE_DIR  (env override)
#   2. <script_dir>/../share/mipster/test/fixtures   (installed FHS layout)
#   3. <script_dir>/fixtures                          (build-tree layout)
#
# Exit code: 0 if all tests pass, 1 if any fail.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Millisecond-precision epoch time. Falls back gracefully on platforms without GNU date.
get_epoch_ms() {
  python3 -c "import time; print(int(time.time()*1000))" 2>/dev/null || \
    { date +%s%3N 2>/dev/null; } || \
    echo $(( $(date +%s) * 1000 ))
}

DEBUG_MODE=0
WRITE_BASELINE_PLATFORM=""
WRITE_BASELINE_FILE=""

# Parse arguments
while [ $# -gt 0 ]; do
  case "$1" in
    --debug)
      DEBUG_MODE=1
      ;;
    --write-baseline)
      WRITE_BASELINE_PLATFORM="${2:-}"
      WRITE_BASELINE_FILE="${3:-}"
      shift 2
      ;;
    --help)
      echo "Usage: run-mipster-tests [--debug] [--write-baseline PLATFORM FILE]"
      echo ""
      echo "  --debug   Use lib/dbg/ library (with ASan on Linux). Sets LD_LIBRARY_PATH"
      echo "            (and LD_PRELOAD for ASan init if libasan is bundled)."
      echo "  --write-baseline PLATFORM FILE"
      echo "            Write CI baseline JSON to FILE after a successful run."
      echo "            PLATFORM is a human-readable string describing the CI machine."
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
  shift
done

# ── Locate fixture directory ─────────────────────────────────────────────────
if [ -z "${MIPSTER_FIXTURE_DIR:-}" ]; then
  if [ -d "$SCRIPT_DIR/fixtures" ]; then
    MIPSTER_FIXTURE_DIR="$SCRIPT_DIR/fixtures"
  elif [ -d "$SCRIPT_DIR/../share/mipster/test/fixtures" ]; then
    MIPSTER_FIXTURE_DIR="$(cd "$SCRIPT_DIR/../share/mipster/test/fixtures" && pwd)"
  else
    echo "WARNING: fixture directory not found; MPS-based tests may fail." >&2
    MIPSTER_FIXTURE_DIR=""
  fi
fi
export MIPSTER_FIXTURE_DIR

# ── Debug library setup (--debug flag) ──────────────────────────────────────
if [ "$DEBUG_MODE" -eq 1 ]; then
  DBG_LIB_DIR=""
  # Look for lib/dbg/ relative to script (tarball layout: script is in bin/)
  if [ -d "${SCRIPT_DIR}/../lib/dbg" ]; then
    DBG_LIB_DIR="$(cd "${SCRIPT_DIR}/../lib/dbg" && pwd)"
  elif [ -d "${SCRIPT_DIR}/lib/dbg" ]; then
    DBG_LIB_DIR="$(cd "${SCRIPT_DIR}/lib/dbg" && pwd)"
  fi

  if [ -n "$DBG_LIB_DIR" ]; then
    export LD_LIBRARY_PATH="${DBG_LIB_DIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    export DYLD_LIBRARY_PATH="${DBG_LIB_DIR}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
    # If libasan is bundled, preload it so ASan runtime initialises before user code.
    local_libasan=$(find "${DBG_LIB_DIR}" -name 'libasan.so.*' ! -type l 2>/dev/null | head -1)
    if [ -n "$local_libasan" ]; then
      export LD_PRELOAD="${local_libasan}${LD_PRELOAD:+:${LD_PRELOAD}}"
    fi
    export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0:abort_on_error=1}"
    echo "    debug library: $DBG_LIB_DIR"
  else
    echo "WARNING: --debug specified but lib/dbg/ not found; running with default library" >&2
  fi
fi

# ── CPU-aware parallelism ────────────────────────────────────────────────────
# Never launch more concurrent single-threaded solves than there are logical
# cores: oversubscribing a constrained CI runner (e.g. 4 vCPUs) with dozens of
# parallel CBC processes causes severe scheduling contention, which can make
# individual tests take vastly longer than their own internal wall-clock
# fallback expects (a test's Cbc_setMaximumSeconds() call only fires once the
# process actually gets scheduled to check it). Override with
# MIPSTER_TEST_JOBS if you want more/less than the detected core count.
detect_ncpu() {
  if command -v nproc >/dev/null 2>&1; then
    nproc
  elif command -v getconf >/dev/null 2>&1 && getconf _NPROCESSORS_ONLN >/dev/null 2>&1; then
    getconf _NPROCESSORS_ONLN
  elif command -v sysctl >/dev/null 2>&1; then
    sysctl -n hw.ncpu
  else
    echo 4
  fi
}
NCPU="$(detect_ncpu)"
MAX_PARALLEL="${MIPSTER_TEST_JOBS:-$NCPU}"

# ── Per-test watchdog ────────────────────────────────────────────────────────
# Each test sets its own internal Cbc wall-clock fallback (Cbc_setMaximumSeconds
# / DBL_PARAM_TIME_LIMIT), but that check only fires when the process gets
# scheduled — under contention (or a genuine hang/livelock) a test can run far
# longer than it should. We externally enforce "internal budget + tolerance"
# and kill the process if it's exceeded, so a single stuck test can never
# again silently consume the whole CI job's execution-time budget (as
# happened once for 6+ hours). Add MIPSTER_TEST_TIMEOUT_TOLERANCE seconds of
# slack (default 300s / 5 min) on top of each test's own expected budget.
TIMEOUT_TOLERANCE_SEC="${MIPSTER_TEST_TIMEOUT_TOLERANCE:-300}"
# Generous fallback for tests without an explicitly-known internal budget below.
DEFAULT_EXPECTED_TIMEOUT_SEC=600

# Known internal wall-clock budgets (seconds), mirroring each test's own
# Cbc_setMaximumSeconds()/DBL_PARAM_TIME_LIMIT call. Keep in sync if a test's
# internal budget changes — an out-of-date (too small) entry here just means
# a slower-than-usual-but-legitimate run gets killed and retried verbosely,
# which is safe; it never causes false failures on its own.
get_expected_timeout_sec() {
  case "$1" in
    CInterfaceTest_mescn)       echo 300 ;;
    CInterfaceTest_graphdraw)   echo 60 ;;
    CInterfaceTest_trdta5581)   echo 30 ;;
    CInterfaceTest_trd445c)     echo 300 ;;
    CInterfaceTest_trdtaunimep) echo 300 ;;
    CInterfaceTest_j3041_1)     echo 180 ;;
    CInterfaceTest_yue20013)    echo 600 ;;
    CInterfaceTest_etDecsi)     echo 120 ;;
    CInterfaceTest_dano3_3)     echo 300 ;;
    CInterfaceTest_leo1)        echo 600 ;;
    CInterfaceTest_bpc)         echo 600 ;;
    CInterfaceTest_mis_*)       echo 300 ;;
    CInterfaceTest_jssp_*)      echo 120 ;;
    CInterfaceTest_upms_*)      echo 120 ;;
    *)                          echo "$DEFAULT_EXPECTED_TIMEOUT_SEC" ;;
  esac
}

# Portable "run with hard timeout" — GNU coreutils' `timeout` isn't guaranteed
# on macOS runners, so implement the watchdog directly with a background
# killer process. Sets global TIMED_OUT=1 if the process had to be killed.
TIMED_OUT=0
run_with_timeout() {
  local limit="$1"; shift
  "$@" &
  local pid=$!
  (
    sleep "$limit"
    kill -TERM "$pid" 2>/dev/null || true
    sleep 10
    kill -KILL "$pid" 2>/dev/null || true
  ) &
  local watchdog=$!
  local rc=0
  wait "$pid" || rc=$?
  # Watchdog still alive => test finished on its own; stop it and clean up.
  if kill -0 "$watchdog" 2>/dev/null; then
    kill "$watchdog" 2>/dev/null || true
    TIMED_OUT=0
  else
    TIMED_OUT=1
  fi
  wait "$watchdog" 2>/dev/null || true
  return "$rc"
}

# ── Test list (order matters for readability) ────────────────────────────────
TESTS=(
  CInterfaceTest
  CInterfaceTest_tsp_random
  CInterfaceTest_fl_random
  CInterfaceTest_mdkp_random
  CInterfaceTest_miclsp
  CInterfaceTest_mescn
  CInterfaceTest_nursesched
  CInterfaceTest_a1
  CInterfaceTest_graphdraw
  CInterfaceTest_trdta5581
  CInterfaceTest_trd445c
  CInterfaceTest_trdtaunimep
  CInterfaceTest_j3041_1
  CInterfaceTest_yue20013
  CInterfaceTest_etDecsi
  CInterfaceTest_dano3_3
  CbcSolverLpTest
  CInterfaceTest_advanced
  CInterfaceTest_colgen
  CInterfaceTest_construction
  CInterfaceTest_facility
  CInterfaceTest_jssp
  CInterfaceTest_kantorovich
  CInterfaceTest_mip_reopt
  CInterfaceTest_new
  CInterfaceTest_tsp_cuts
  CInterfaceTest_vrp
  CInterfaceTest_qap
  CInterfaceTest_setcover
  CInterfaceTest_setpacking
  CInterfaceTest_setpartitioning
  CInterfaceTest_bpc
  CInterfaceTest_mis_n15_sd42_random_uniform
  CInterfaceTest_mis_n20_sd42_geometric_unit
  CInterfaceTest_mis_n16_sd137_grid_diverse
  CInterfaceTest_mis_n18_sd42_k_partite_uniform
  CInterfaceTest_mis_n20_sd137_tree_uniform
  CInterfaceTest_mis_n30_sd42_random_uniform
  CInterfaceTest_mis_n35_sd137_geometric_diverse
  CInterfaceTest_mis_n36_sd42_grid_unit
  CInterfaceTest_mis_n40_sd137_planar_uniform
  CInterfaceTest_mis_n30_sd42_cycle_uniform
  CInterfaceTest_jssp_ft06
  CInterfaceTest_jssp_ft10
  CInterfaceTest_jssp_la01
  CInterfaceTest_jssp_la06
  CInterfaceTest_jssp_la11
  CInterfaceTest_jssp_orb01
  CInterfaceTest_steiner
  CInterfaceTest_fcnf_fixtures
  CInterfaceTest_upms_n8_m2_int_cmax_s42
  CInterfaceTest_upms_n8_m3_int_wct_s42
  CInterfaceTest_upms_n9_m3_int_cmax_s137
  CInterfaceTest_upms_n8_m3_frac_cmax_s42
  CInterfaceTest_upms_n9_m2_lgset_cmax_s137
  CInterfaceTest_upms_n7_m3_int_wct_s137
  CInterfaceTest_gap
  CInterfaceTest_leo1
  CInterfaceTest_parity
)

TOTAL=${#TESTS[@]}
PASS=0
FAIL=0
FAILURES=()
TEST_RESULTS=()   # entries: "TestName:elapsed_ms"

# ── Helpers ──────────────────────────────────────────────────────────────────
# Width of the counter field (e.g. 2 for totals up to 99)
W=${#TOTAL}
# Fixed width for the test name column (wide enough for per-fixture names)
NAME_COL=48

find_bin() {
  local name="$1"
  if [ -x "$SCRIPT_DIR/$name" ]; then echo "$SCRIPT_DIR/$name"
  elif [ -x "$SCRIPT_DIR/test/$name" ]; then echo "$SCRIPT_DIR/test/$name"
  elif command -v "$name" >/dev/null 2>&1; then command -v "$name"
  elif [ -x "./$name" ]; then echo "./$name"
  fi
}

# ── Run all tests in parallel ────────────────────────────────────────────────
echo "=== MIPster Test Suite ==="
[ -n "$MIPSTER_FIXTURE_DIR" ] && echo "    fixtures: $MIPSTER_FIXTURE_DIR"
echo ""

declare -a _pids _start_ms _tmpfiles _bins

# Tests that require fixture directory as first argument
FIXTURE_TESTS=(
  CInterfaceTest_vrp
  CInterfaceTest_qap
  CInterfaceTest_setcover
  CInterfaceTest_setpacking
  CInterfaceTest_setpartitioning
  CInterfaceTest_bpc
  CInterfaceTest_mis_n15_sd42_random_uniform
  CInterfaceTest_mis_n20_sd42_geometric_unit
  CInterfaceTest_mis_n16_sd137_grid_diverse
  CInterfaceTest_mis_n18_sd42_k_partite_uniform
  CInterfaceTest_mis_n20_sd137_tree_uniform
  CInterfaceTest_mis_n30_sd42_random_uniform
  CInterfaceTest_mis_n35_sd137_geometric_diverse
  CInterfaceTest_mis_n36_sd42_grid_unit
  CInterfaceTest_mis_n40_sd137_planar_uniform
  CInterfaceTest_mis_n30_sd42_cycle_uniform
  CInterfaceTest_jssp_ft06
  CInterfaceTest_jssp_ft10
  CInterfaceTest_jssp_la01
  CInterfaceTest_jssp_la06
  CInterfaceTest_jssp_la11
  CInterfaceTest_jssp_orb01
  CInterfaceTest_steiner
  CInterfaceTest_fcnf_fixtures
  CInterfaceTest_upms_n8_m2_int_cmax_s42
  CInterfaceTest_upms_n8_m3_int_wct_s42
  CInterfaceTest_upms_n9_m3_int_cmax_s137
  CInterfaceTest_upms_n8_m3_frac_cmax_s42
  CInterfaceTest_upms_n9_m2_lgset_cmax_s137
  CInterfaceTest_upms_n7_m3_int_wct_s137
  CInterfaceTest_gap
  CInterfaceTest_parity
)

# Per-fixture tests: resolve actual binary name from display name.
# Uses a function (not declare -A) for bash 3.x compatibility (macOS /bin/bash).
get_bin_name() {
  case "$1" in
    CInterfaceTest_mis_*)           echo "CInterfaceTest_mis" ;;
    CInterfaceTest_jssp_ft06|\
    CInterfaceTest_jssp_ft10|\
    CInterfaceTest_jssp_la01|\
    CInterfaceTest_jssp_la06|\
    CInterfaceTest_jssp_la11|\
    CInterfaceTest_jssp_orb01)      echo "CInterfaceTest_jssp_fixtures" ;;
    CInterfaceTest_upms_*)          echo "CInterfaceTest_upms" ;;
    *)                              echo "$1" ;;
  esac
}

# Per-fixture tests: resolve fixture name arg from display name.
# Strip the standard prefix to get the fixture stem.
get_fixture_arg() {
  case "$1" in
    CInterfaceTest_mis_*)   echo "${1#CInterfaceTest_}" ;;
    CInterfaceTest_jssp_*)  echo "${1#CInterfaceTest_}" ;;
    CInterfaceTest_upms_*)  echo "${1#CInterfaceTest_}" ;;
    *)                      echo "" ;;
  esac
}

# Phase 1: resolve binaries/args for every test up front (no launching yet)
declare -a _args _needs_fixtures _timeout_sec _rcfiles _timeoutfiles _elapsedfiles
for i in "${!TESTS[@]}"; do
  name="${TESTS[$i]}"
  bin_name=$(get_bin_name "$name")
  bin=$(find_bin "$bin_name")
  _bins[$i]="$bin"
  _tmpfiles[$i]=$(mktemp)
  _rcfiles[$i]=$(mktemp)
  _timeoutfiles[$i]=$(mktemp)
  _elapsedfiles[$i]=$(mktemp)

  needs_fixtures=0
  for ft in "${FIXTURE_TESTS[@]}"; do
    if [ "$name" = "$ft" ]; then
      needs_fixtures=1
      break
    fi
  done
  _needs_fixtures[$i]="$needs_fixtures"

  fixture_arg=$(get_fixture_arg "$name")
  if [ "$needs_fixtures" -eq 1 ] && [ -n "$MIPSTER_FIXTURE_DIR" ]; then
    _args[$i]="$MIPSTER_FIXTURE_DIR ${fixture_arg}"
  else
    _args[$i]=""
  fi

  expected=$(get_expected_timeout_sec "$name")
  _timeout_sec[$i]=$(( expected + TIMEOUT_TOLERANCE_SEC ))
done

echo "    parallelism: ${MAX_PARALLEL} concurrent test(s) (detected ${NCPU} core(s); override with MIPSTER_TEST_JOBS)"
echo ""

# Launches one test in the background; writes exit code + timeout flag to
# per-test files once done. On timeout, automatically retries once with
# MIPSTER_FORCE_LOG_LEVEL=3 for extra diagnostics before giving up.
launch_test() {
  local i="$1"
  local bin="${_bins[$i]}"
  local tmpfile="${_tmpfiles[$i]}"
  local rcfile="${_rcfiles[$i]}"
  local timeoutfile="${_timeoutfiles[$i]}"
  local elapsedfile="${_elapsedfiles[$i]}"
  local timeout_sec="${_timeout_sec[$i]}"
  # shellcheck disable=SC2206 (word-splitting of args is intentional here)
  local args=(${_args[$i]})

  local start_ms
  start_ms=$(get_epoch_ms)
  _start_ms[$i]="$start_ms"
  (
    rc=0
    run_with_timeout "$timeout_sec" "$bin" "${args[@]}" > "$tmpfile" 2>&1 || rc=$?
    timed_out="$TIMED_OUT"
    if [ "$timed_out" -eq 1 ]; then
      {
        echo ""
        echo "*** TIMEOUT: exceeded ${timeout_sec}s (expected budget + ${TIMEOUT_TOLERANCE_SEC}s tolerance) — process killed. ***"
        echo "*** Re-running once with MIPSTER_FORCE_LOG_LEVEL=3 for diagnostics... ***"
        echo ""
      } >> "$tmpfile"
      MIPSTER_FORCE_LOG_LEVEL=3 run_with_timeout "$timeout_sec" "$bin" "${args[@]}" >> "$tmpfile" 2>&1 || true
      rc=124 # sentinel: a timeout is always reported as a failure, regardless
             # of whether the diagnostic re-run happened to finish in time.
    fi
    # Capture elapsed time here (test completion), not later in Phase 2 —
    # Phase 2 only runs after the whole batched suite finishes, so computing
    # "now - start" there would report time-until-suite-end, not
    # time-until-this-test-end.
    echo "$(( $(get_epoch_ms) - start_ms ))" > "$elapsedfile"
    echo "$rc" > "$rcfile"
    echo "$timed_out" > "$timeoutfile"
  ) &
  _pids[$i]=$!
}

# Run tests in CPU-capped batches (portable across bash versions — avoids
# `wait -n`, which isn't available in the bash 3.2 shipped on macOS).
NUM_TESTS=${#TESTS[@]}
batch_start=0
while [ "$batch_start" -lt "$NUM_TESTS" ]; do
  batch_end=$(( batch_start + MAX_PARALLEL ))
  [ "$batch_end" -gt "$NUM_TESTS" ] && batch_end="$NUM_TESTS"
  for (( j = batch_start; j < batch_end; j++ )); do
    if [ -n "${_bins[$j]}" ]; then
      launch_test "$j"
    fi
  done
  for (( j = batch_start; j < batch_end; j++ )); do
    if [ -n "${_pids[$j]:-}" ]; then
      wait "${_pids[$j]}" 2>/dev/null || true
    fi
  done
  batch_start="$batch_end"
done

# Phase 2: collect + print results in original order
for i in "${!TESTS[@]}"; do
  name="${TESTS[$i]}"
  idx=$(( i + 1 ))
  bin="${_bins[$i]}"
  tmpfile="${_tmpfiles[$i]}"
  rcfile="${_rcfiles[$i]}"
  timeoutfile="${_timeoutfiles[$i]}"
  elapsedfile="${_elapsedfiles[$i]}"

  if [ -z "$bin" ]; then
    printf "[%*d/%d] %-*s SKIP  (not found)\n" "$W" "$idx" "$TOTAL" "$NAME_COL" "$name"
    rm -f "$tmpfile" "$rcfile" "$timeoutfile" "$elapsedfile"
    continue
  fi

  rc=$(cat "$rcfile" 2>/dev/null || echo 1)
  timed_out=$(cat "$timeoutfile" 2>/dev/null || echo 0)
  elapsed_ms=$(cat "$elapsedfile" 2>/dev/null || echo 0)
  elapsed_s=$(awk "BEGIN { printf \"%.1f\", ${elapsed_ms}/1000 }" 2>/dev/null || echo "${elapsed_ms}")

  printf "[%*d/%d] %-*s" "$W" "$idx" "$TOTAL" "$NAME_COL" "$name"

  if [ "$rc" -eq 0 ]; then
    printf " PASS  (%ss)\n" "$elapsed_s"
    PASS=$(( PASS + 1 ))
    TEST_RESULTS+=("${name}:${elapsed_ms}")
  else
    if [ "$timed_out" -eq 1 ]; then
      printf " FAIL  (%ss, TIMEOUT)\n" "$elapsed_s"
    else
      printf " FAIL  (%ss)\n" "$elapsed_s"
    fi
    FAIL=$(( FAIL + 1 ))
    FAILURES+=("$name")
    TEST_RESULTS+=("${name}:${elapsed_ms}")
    sed 's/^/    | /' "$tmpfile"
    printf '    \n'
  fi
  rm -f "$tmpfile" "$rcfile" "$timeoutfile" "$elapsedfile"
done

# ── Summary ──────────────────────────────────────────────────────────────────
echo ""
if [ "$FAIL" -eq 0 ]; then
  echo "All ${PASS} tests passed."

  # ── Write baseline (CI mode) ───────────────────────────────────────────────
  if [ -n "${WRITE_BASELINE_FILE:-}" ] && [ -n "${WRITE_BASELINE_PLATFORM:-}" ]; then
    mkdir -p "$(dirname "${WRITE_BASELINE_FILE}")"
    python3 - "${WRITE_BASELINE_PLATFORM}" "${WRITE_BASELINE_FILE}" "${TEST_RESULTS[@]}" << 'PYEOF'
import sys, json, datetime
platform_str = sys.argv[1]
out_file = sys.argv[2]
times = {}
for arg in sys.argv[3:]:
    name, ms = arg.rsplit(":", 1)
    times[name] = int(ms)
data = {
    "platform": platform_str,
    "generated": datetime.date.today().isoformat(),
    "times_ms": times
}
with open(out_file, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True)
PYEOF
    echo "    Baseline written: ${WRITE_BASELINE_FILE}"
  fi

  # ── Comparison vs CI baseline (user mode) ─────────────────────────────────
  if [ -z "${WRITE_BASELINE_FILE:-}" ] && command -v python3 >/dev/null 2>&1; then
    # Locate the bundled CI baseline: script lives in bin/, baseline in share/mipster/test/
    BASELINE_FILE=""
    for candidate in \
      "${SCRIPT_DIR}/../share/mipster/test/ci-baseline-times.json" \
      "${SCRIPT_DIR}/share/mipster/test/ci-baseline-times.json"; do
      if [ -f "${candidate}" ]; then
        BASELINE_FILE="${candidate}"
        break
      fi
    done

    if [ -n "${BASELINE_FILE}" ]; then
      python3 - "${BASELINE_FILE}" "${TEST_RESULTS[@]}" << 'PYEOF'
import sys, json, math
baseline_file = sys.argv[1]
test_results = {}
for arg in sys.argv[2:]:
    name, ms = arg.rsplit(":", 1)
    test_results[name] = int(ms)

try:
    with open(baseline_file) as f:
        baseline = json.load(f)
    bl_times = baseline.get("times_ms", {})
    platform = baseline.get("platform", "unknown")
    date = baseline.get("generated", "unknown")
except Exception as e:
    sys.exit(0)   # silently skip if baseline can't be loaded

comparable = [(name, test_results[name], bl_times[name])
              for name in test_results if name in bl_times and test_results[name] > 0]
if not comparable:
    sys.exit(0)

W = 42
print(f"\n=== Performance vs CI baseline ===")
print(f"    Baseline: {platform} ({date})")
print(f"{'Test':<{W}} {'Yours':>8} {'CI':>8} {'Speedup':>10}")
print("-" * (W + 30))
ratios = []
for name, your_ms, ci_ms in sorted(comparable):
    ratio = ci_ms / max(your_ms, 1)
    ratios.append(ratio)
    sym = "↑" if ratio >= 1.0 else "↓"
    print(f"{name:<{W}} {your_ms/1000:>7.1f}s {ci_ms/1000:>7.1f}s  {sym}{ratio:>7.2f}x")
if len(ratios) >= 2:
    geomean = math.exp(sum(math.log(r) for r in ratios) / len(ratios))
    desc = "faster than" if geomean >= 1.0 else "slower than"
    print("-" * (W + 30))
    print(f"{'Geometric mean:':<{W}} {'':>8} {'':>8}  {geomean:>7.2f}x {desc} CI")
PYEOF
    fi
  fi
else
  echo "${FAIL}/${TOTAL} test(s) FAILED: ${FAILURES[*]}"
  exit 1
fi
